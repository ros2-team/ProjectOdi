        <mxCell id="p3-e15" value="② 로 복귀 (다음 물체 / 탐험 계속)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;endArrow=block;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p3-1" source="p3-done" target="p3-lane"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="968" /><mxPoint x="350" y="900" /><mxPoint x="180" y="900" /></Array></mxGeometry></mxCell>

        <mxCell id="p3-side" value="병행 흐름 (실행순서와 무관 · 상시)&lt;br&gt;&lt;br&gt;behavior_executor 는 각 단계 결과를 Topic 으로 재발행한다.&lt;br&gt;  · /first_encounter/result  (③ 직후)&lt;br&gt;  · /curiosity/decision      (④ 직후)&lt;br&gt;  · /observation/result      (⑤-A 직후)&lt;br&gt;  · /behavior/state          (1초 주기)&lt;br&gt;&lt;br&gt;odi_web_bridge 가 이 4개를 구독해 WS /ws 로 브라우저에 푸시.&lt;br&gt;포트폴리오용으로 압축할 때는 이 블록을 빼도 핵심 흐름은 유지된다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="p3-1">
