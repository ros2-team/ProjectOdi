        <mxCell id="p3-e5" value="④-1  Service&lt;br&gt;/world_memory/get_similar_observations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 4;strokeColor=#9673a6;fontSize=10;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3-1" source="p3-ce" target="p3-wm"><mxGeometry relative="1" as="geometry" /></mxCell>
