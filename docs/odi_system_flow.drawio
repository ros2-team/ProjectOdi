  <diagram id="page4" name="04_Mission 상태 흐름">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="p4-0" />
        <mxCell id="p4-1" parent="p4-0" />

        <mxCell id="p4-title" value="ProjectOdi — 04. Mission 상태 흐름 (MissionStatus FSM + EXPLORING 내부 단계)" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;" vertex="1" parent="p4-1">
          <mxGeometry x="60" y="20" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p4-sub" value="상태 전이는 전부 /mission/command (외부 명령) 또는 /behavior/event · /normal/event (하위 노드 보고)로만 일어난다. mission_manager_node.py 기준." style="text;html=1;fontSize=12;fontColor=#666666;" vertex="1" parent="p4-1">
