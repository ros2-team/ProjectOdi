        <mxCell id="p3-lg2" style="html=1;dashed=1;dashPattern=8 4;strokeColor=#9673a6;endArrow=block;" edge="1" parent="p3-lg"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="75" as="sourcePoint" /><mxPoint x="100" y="75" as="targetPoint" /></mxGeometry></mxCell>
